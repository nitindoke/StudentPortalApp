@model List<StudentPortal.Web.Models.Entities.Course>

<h1>Courses</h1>

<p>
    <a class="btn btn-success" asp-action="Add">Add Course</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Credits</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Id</td>
                <td>@course.Title</td>
                <td>@course.Description</td>
                <td>@course.Credits</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@course.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
