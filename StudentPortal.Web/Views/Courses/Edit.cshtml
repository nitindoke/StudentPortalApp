@model StudentPortal.Web.Models.Entities.Course

<h1>Edit Course</h1>

@if (Model is null)
{
    <p>No Course was found with this Id</p>
}
else
{
    <form method="post">
        <div class="mt-3">
            <label class="form-label">Id</label>
            <input type="text" class="form-control" asp-for="Id" readonly />
        </div>

        <div class="mt-3">
            <label class="form-label">Title</label>
            <input type="text" class="form-control" asp-for="Title" />
        </div>

        <div class="mt-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" asp-for="Description"></textarea>
        </div>

        <div class="mt-3">
            <label class="form-label">Credits</label>
            <input type="number" class="form-control" asp-for="Credits" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="submit" class="btn btn-danger ms-3" asp-action="Delete" asp-controller="Courses">Delete</button>
        </div>
    </form>
}
